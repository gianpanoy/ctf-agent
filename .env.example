# CTFd (required for ctf-solve mode)
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Vulnerability scanning mode (vuln-scan command)
# Minimum severity to report: CRITICAL, HIGH, MEDIUM, or LOW
TRIVY_SEVERITY=CRITICAL,HIGH
# Max vulnerability findings to investigate per target (controls cost)
MAX_VULN_FINDINGS=5
# Directory where analysis reports are written
REPORT_OUTPUT_DIR=vuln-reports
